cc_library_shared {
    name: "camera.msm8953",
    compile_multilib: "32",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-error",
        "-DQCAMERA_HAL3_SUPPORT",
        "-DSYSTEM_HEADER_PREFIX=sys",
        "-DHAS_MULTIMEDIA_HINTS",
        "-D_ANDROID",
        "-DUSE_MEDIA_EXTENSIONS",
        "-DDEFAULT_DENOISE_MODE_ON",
        "-DHAL3",
        "-DQCAMERA_REDEFINE_LOG",
        "-DVENUS_PRESENT",
    ],
    include_dirs: [
        "device/motorola/deen/camera/mm-image-codec/qexif",
        "device/motorola/deen/camera/mm-image-codec/qomx_core",
        "hardware/qcom-caf/msm8996/media/libstagefrighthw",
        "hardware/qcom-caf/msm8996/media/mm-core/inc",
        "system/memory/libion/kernel-headers",
        "system/memory/libion/include",
        "hardware/qcom-caf/msm8996/display/libqservice",
    ],
    local_include_dirs: [
        "stack/mm-camera-interface/inc",
        "util",
        "HAL3",
    ],
    header_libs: [
        "media_plugin_headers",
        "libandroid_sensor_headers",
        "libcutils_headers",
        "libsystem_headers",
        "libhardware_headers",
        "display_headers",
        "generated_kernel_headers",
        "camera_common_headers",
    ],

    relative_install_path: "hw",

    vendor: true,

    shared_libs: [
        "liblog",
        "libhardware",
        "libutils",
        "libcutils",
        "libdl",
        "libsync",
        "libmmcamera_interface",
        "libmmjpeg_interface",
        "libcamera_metadata",
        "libqdMetaData",
        "libqservice",
        "libbinder",
        "libion",
    ],
    srcs: [
        "util/QCameraBufferMaps.cpp",
        "util/QCameraCmdThread.cpp",
        "util/QCameraFlash.cpp",
        "util/QCameraPerf.cpp",
        "util/QCameraQueue.cpp",
        "util/QCameraCommon.cpp",
        "QCamera2Hal.cpp",
        "QCamera2Factory.cpp",
        "HAL3/QCamera3HWI.cpp",
        "HAL3/QCamera3Mem.cpp",
        "HAL3/QCamera3Stream.cpp",
        "HAL3/QCamera3Channel.cpp",
        "HAL3/QCamera3VendorTags.cpp",
        "HAL3/QCamera3PostProc.cpp",
        "HAL3/QCamera3CropRegionMapper.cpp",
        "HAL3/QCamera3StreamMem.cpp",
    ],
    static_libs: ["android.hardware.camera.common@1.0-helper"],
}

cc_library_headers {
    name: "camera_common_headers",
    vendor: true,
    export_include_dirs: ["stack/common"],
}
