#
# vendor props for deen
#

# Audio
af.fast_track_multiplier=1
audio.deep_buffer.media=true
audio.offload.video=false
vendor.audio.feature.audiozoom.enable=false
persist.vendor.audio.dualmic.config=endfire
persist.vendor.audio.fluence.audiorec=false
persist.vendor.audio.fluence.speaker=true
persist.vendor.audio.fluence.voicecall=true
persist.vendor.audio.fluence.voicecomm=true
persist.vendor.audio.fluence.voicerec=false
persist.vendor.audio.hw.binder.size_kbyte=1024
persist.vendor.audio.ras.enabled=false
ro.vendor.audio.sdk.fluencetype=none
ro.vendor.audio.sdk.ssr=false
vendor.audio.flac.sw.decoder.24bit=true
vendor.audio.hw.aac.encoder=true
vendor.audio.noisy.broadcast.delay=600
vendor.audio.offload.buffer.size.kb=64
vendor.audio.offload.gapless.enabled=false
vendor.audio.offload.min.duration.secs=60
vendor.audio.offload.multiaac.enable=true
vendor.audio.offload.multiple.enabled=false
vendor.audio.offload.passthrough=false
vendor.audio.offload.pcm.16bit.enable=false
vendor.audio.offload.pcm.24bit.enable=false
vendor.audio.offload.pstimeout.secs=3
vendor.audio.offload.track.enable=true
vendor.audio.parser.ip.buffer.size=262144
vendor.audio.safx.pbe.enabled=true
vendor.audio.spkr_prot.tx.sampling_rate=48000
vendor.audio.tunnel.encode=false
vendor.audio.use.sw.alac.decoder=true
vendor.audio.use.sw.ape.decoder=true
vendor.audio_hal.period_size=240
vendor.voice.path.for.pcm.voip=false

# Bluetooth
persist.vendor.bluetooth.modem_nv_support=true
persist.vendor.qcom.bluetooth.enable.splita2dp=false
persist.vendor.qcom.bluetooth.soc=pronto
ro.vendor.bluetooth.wipower=false
vendor.audio.feature.a2dp_offload.enable=false
vendor.qcom.bluetooth.soc=pronto

# Camera
persist.vendor.camera.HAL3.enabled=1
vendor.camera.aux.packageblacklist=com.discord
vendor.camera.aux.packagelist=,com.android.camera2,com.google.android.GoogleCamera.cameralite
vendor.camera.aux.packagelist2=com.android.camera,com.android.systemui,com.huaqin.cameraautotest,com.huaqin.runtime
vendor.camera.aux.packagelist3=org.codeaurora.snapcam,org.lineageos.snap,com.google.android.GoogleCamera
vendor.camera.hal1.packagelist=com.skype.raider,com.whatsapp,com.instagram.android
vendor.camera.lowpower.record.enable=1

# Codec2 switch
debug.media.codec2=2

# Color Mode
debug.sf.hw=1
debug.sf.latch_unsignaled=0
dev.pm.dyn_samplingrate=1
ro.opengles.version=196610
vendor.display.enable_default_color_mode=1
vendor.gralloc.enable_fb_ubwc=1
vendor.display.disable_rotator_downscale=1

# DRM
drm.service.enabled=true

# Factory reset partition
ro.frp.pst=/dev/block/platform/soc/7824900.sdhci/by-name/frp

# FS-verity
ro.apk_verity.mode=2

# Graphics
ro.hardware.egl=adreno
ro.hardware.vulkan=msm8953

# Keystore
ro.hardware.keystore_desede=true

# Media
vendor.mm.enable.qcom_parser=33559074
vendor.vidc.disable.split.mode=1
vendor.vidc.enc.disable.pq=true
vendor.video.disable.ubwc=1

# OMX
debug.stagefright.omx_default_rank.sw-audio=1
debug.stagefright.omx_default_rank=0
media.stagefright.thumbnail.prefer_hw_codecs=true

# OEM Unlock reporting
ro.oem_unlock_supported=1

# Perf
ro.vendor.extension_library=libqti-perfd-client.so

# Radio
ro.vendor.build.vendorprefix=/vendor
persist.vendor.radio.mt_sms_ack=30
persist.radio.multisim.config=dsds
persist.vendor.dpmhalservice.enable=1
persist.vendor.radio.apm_sim_not_pwdn=1
persist.vendor.radio.custom_ecc=1
persist.vendor.radio.enableadvancedscan=false
persist.vendor.radio.procedure_bytes=SKIP
persist.vendor.radio.rat_on=other
persist.vendor.radio.sib16_support=1
vendor.rild.libpath=/vendor/lib64/libril-qc-hal-qmi.so
persist.vendor.cne.feature=1
persist.vendor.radio.force_on_dc=true
persist.vendor.radio.data_con_rprt=true
persist.vendor.data.profile_update=true
persist.vendor.ims.dropset_feature=1
persist.vendor.radio.ignore_dom_time=5
ro.vendor.use_data_netmgrd=true
persist.vendor.data.mode=concurrent
persist.vendor.data.iwlan.enable=true
ro.telephony.default_network=9,9
telephony.lteOnCdmaDevice=0

# Volume
ro.config.media_vol_steps=30
ro.config.vc_call_vol_steps=9

# Sensors
ro.hardware.sensors=deen
ro.vendor.sdk.sensors.gestures=false
ro.vendor.sensors.amd=false
ro.vendor.sensors.facing=false
ro.vendor.sensors.mot_detect=true
ro.vendor.sensors.mot_ltv=true
ro.vendor.sensors.pedometer=false
ro.vendor.sensors.pmd=false
ro.vendor.sensors.rmd=false
ro.vendor.sensors.scrn_ortn=false
ro.vendor.sensors.smd=false
ro.vendor.sensors.sta_detect=true

# SurfaceFlinger
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.use_color_management=true

# Time Services
persist.vendor.delta_time.enable=true

# Wifi
wifi.interface=wlan0
